# Variable specifying execution environment
# Possible values: production,staging,development,local,test
ENVIRONMENT=development

# Django variable to provide cryptographic signing.
# See: https://docs.djangoproject.com/en/2.1/ref/settings/#secret-key
SECRET_KEY='{{DJANGO_SECRET_KEY}}'

# Django variable to provide cryptographic signing.
# See: https://docs.djangoproject.com/en/2.1/ref/settings/#secret-key
JWT_ALGORITHM=HS256

# The SQL database configuration
RDS_DB_NAME=okuna
RDS_USERNAME=postgres
RDS_HOSTNAME=127.0.0.1
RDS_PORT=5432
RDS_HOSTNAME_READER=127.0.0.1
RDS_HOSTNAME_WRITER=127.0.0.1
RDS_PASSWORD={{POSTGRES_PASSWORD}}

# The SQL test database configuration
TEST_DB_NAME=okuna_test
TEST_DB_USERNAME=postgres
TEST_DB_HOSTNAME=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_PASSWORD={{POSTGRES_PASSWORD}}

# Redis Database configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD={{REDIS_PASSWORD}}

# Geospatial libraries required by GeoDjango
# Linux version
GDAL_LIBRARY_PATH="/usr/lib/libgdal.so"
GEOS_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu/libgeos_c.so"
PROJ_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu/libproj.so"
# Mac Homebrew installed version
# GDAL_LIBRARY_PATH="/opt/homebrew/lib/libgdal.dylib"
# GEOS_LIBRARY_PATH="/opt/homebrew/lib/libgeos_c.dylib"
# PROJ_LIBRARY_PATH="/opt/homebrew/lib/libproj.dylib"

# Enabling this on ARM Macs uses an ARM image for Postgis
# POSTGRES_IMAGE=ghcr.io/baosystems/postgis:12-3.3

# Imagekit.io access keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Ory access keys
ORY_BASE_URL=https://dev-auth.holi.social
ORY_ACCESS_TOKEN=

GOOGLE_CLOUD_PROJECT_ID=holi-dev
PUBSUB_EMULATOR_HOST=localhost:8085

# The ID of an existing space, that is used for Daily Inspiration Posts
INSPIRATION_SPACE_ID=

# Novu access key
NOVU_API_KEY=
NOVU_API_URL=https://eu.api.novu.co

# Chat Server Configuration
# Default is to connect to the staging chat-server
CHAT_SERVER_NAME="development-chat.holi.social"
CHAT_SERVER_URL="http://development-chat.holi.social:8008"
# Use this when you run a local chatserver
# CHAT_SERVER_NAME="local.chat.holi.social"
# CHAT_SERVER_URL="http://local.chat.holi.social:8008"
# An admin account can be created with a script in the holi-chat-server project
CHAT_ADMIN_ACCESS_TOKEN=
