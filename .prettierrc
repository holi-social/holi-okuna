{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "importOrder": [
    "^@holi/core/helpers/__mocks__/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@react-navigation/(.*)$",
    "^@holi/(.*)$",
    "^@holi-apps/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
